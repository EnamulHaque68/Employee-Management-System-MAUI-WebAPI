                  },
                  "Email": {
                    "type": "string",
                    "format": "email"
                  },
                  "Phone": {
                    "pattern": "^(?:\\+?880|0)1[3-9]\\d{8}$",
                    "type": "string"
                  },
                  "Salary": {
                    "type": "number",
                    "format": "double"
                  },
                  "JoinDate": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "IsActive": {
                    "type": "boolean"
                  },
                  "Profile": {
                    "type": "string",
                    "format": "binary"
                  },
                  "DepartmentId": {
                    "type": "integer",
                    "format": "int32"
                  },
                  "DesignationJson": {
                    "type": "string"
                  }
                }
              },
              "encoding": {
                "EmployeeName": {
                  "style": "form"
