<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:NextEvdMaui.Models"
             x:Class="NextEvdMaui.EmployeeDetailsPage"
             x:DataType="models:Employee"
             Title="Employee Details">

    <ContentPage.Resources>
        <ResourceDictionary>
            <Style x:Key="SectionCardStyle" TargetType="Border">
                <Setter Property="StrokeShape" Value="RoundRectangle(16)" />
                <Setter Property="Stroke" Value="#ECECF2" />
                <Setter Property="StrokeThickness" Value="1" />
                <Setter Property="BackgroundColor" Value="White" />
                <Setter Property="Padding" Value="18,16" />
                <Setter Property="Shadow">
                    <Setter.Value>
                        <Shadow Brush="#1A000000" Offset="0,2" Radius="10" Opacity="0.08" />
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="SectionHeaderStyle" TargetType="Label">
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="TextColor" Value="#6E6E80" />
                <Setter Property="CharacterSpacing" Value="0.5" />
            </Style>
            <Style x:Key="InfoLabelStyle" TargetType="Label">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="TextColor" Value="#9A9AA6" />
            </Style>
            <Style x:Key="InfoValueStyle" TargetType="Label">
                <Setter Property="FontSize" Value="15" />
                <Setter Property="TextColor" Value="#1F1F24" />
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Edit" Clicked="OnEditClicked" />
        <ToolbarItem Text="Delete" Clicked="OnDeleteClicked" />
    </ContentPage.ToolbarItems>

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16" BackgroundColor="#F6F6F9">

            <!-- Profile header -->
            <Border StrokeShape="RoundRectangle(20)"
                    Stroke="#ECECF2"
                    StrokeThickness="1"
                    BackgroundColor="White"
                    Padding="20,24">
                <Border.Shadow>
                    <Shadow Brush="#1A000000" Offset="0,2" Radius="10" Opacity="0.08" />
                </Border.Shadow>

                <VerticalStackLayout Spacing="10" HorizontalOptions="Center">

                    <Border StrokeShape="RoundRectangle(48)"
                            Stroke="{StaticResource Primary}"
                            StrokeThickness="2"
                            HeightRequest="96"
                            WidthRequest="96"
                            HorizontalOptions="Center">
                        <Image Source="{Binding DisplayedImageSource}"
                               Aspect="AspectFill" />
                    </Border>

                    <Label Text="{Binding EmployeeName}"
                           FontSize="21"
                           FontAttributes="Bold"
                           TextColor="#1F1F24"
                           HorizontalOptions="Center" />

                    <HorizontalStackLayout Spacing="8" HorizontalOptions="Center">

                        <Border StrokeShape="RoundRectangle(20)"
                                BackgroundColor="#EFEAFB"
                                Padding="12,5"
                                IsVisible="{Binding DepartmentName, Converter={StaticResource StringNotEmptyConverter}}">
                            <Label Text="{Binding DepartmentName}"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource Primary}" />
                        </Border>

                        <Border StrokeShape="RoundRectangle(20)"
                                BackgroundColor="#E7F7EE"
                                Padding="12,5"
                                IsVisible="{Binding IsActive}">
                            <Label Text="Active"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   TextColor="#1E8E4A" />
                        </Border>

                        <Border StrokeShape="RoundRectangle(20)"
                                BackgroundColor="#FBEAEA"
                                Padding="12,5"
                                IsVisible="{Binding IsActive, Converter={StaticResource InvertedBoolConverter}}">
                            <Label Text="Inactive"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   TextColor="#C13B3B" />
                        </Border>

                    </HorizontalStackLayout>

                </VerticalStackLayout>
            </Border>

            <!-- Contact & employment details -->
            <Border Style="{StaticResource SectionCardStyle}">
                <VerticalStackLayout Spacing="14">
                    <Label Text="EMPLOYEE INFORMATION" Style="{StaticResource SectionHeaderStyle}" />

                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="14" ColumnSpacing="12">

                        <VerticalStackLayout Grid.Row="0" Grid.Column="0" Spacing="2">
                            <Label Text="Department" Style="{StaticResource InfoLabelStyle}" />
                            <Label Text="{Binding DepartmentName}" Style="{StaticResource InfoValueStyle}" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Row="0" Grid.Column="1" Spacing="2">
                            <Label Text="Salary" Style="{StaticResource InfoLabelStyle}" />
                            <Label Text="{Binding Salary, StringFormat='{0:C}'}" Style="{StaticResource InfoValueStyle}" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Row="1" Grid.Column="0" Spacing="2">
                            <Label Text="Join Date" Style="{StaticResource InfoLabelStyle}" />
                            <Label Text="{Binding JoinDate, StringFormat='{0:d}'}" Style="{StaticResource InfoValueStyle}" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Row="1" Grid.Column="1" Spacing="2">
                            <Label Text="Status" Style="{StaticResource InfoLabelStyle}" />
                            <Label Text="{Binding IsActive, StringFormat='{0}'}" Style="{StaticResource InfoValueStyle}" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Spacing="2">
                            <Label Text="Email" Style="{StaticResource InfoLabelStyle}" />
                            <Label Text="{Binding Email}" Style="{StaticResource InfoValueStyle}" />
                        </VerticalStackLayout>

                    </Grid>

                    <BoxView HeightRequest="1" Color="#F0F0F4" />

                    <VerticalStackLayout Spacing="2">
                        <Label Text="Phone" Style="{StaticResource InfoLabelStyle}" />
                        <Label Text="{Binding Phone}" Style="{StaticResource InfoValueStyle}" />
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </Border>

            <!-- Designations -->
            <Border Style="{StaticResource SectionCardStyle}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="DESIGNATIONS" Style="{StaticResource SectionHeaderStyle}" />

                    <VerticalStackLayout Spacing="10"
                                          BindableLayout.ItemsSource="{Binding Designations}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:Designation">
                                <Border StrokeShape="RoundRectangle(12)"
                                        Stroke="#EEEEF3"
                                        StrokeThickness="1"
                                        Padding="14,12"
                                        BackgroundColor="#FAFAFC">
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="{Binding DesignationName}"
                                               FontAttributes="Bold"
                                               FontSize="14"
                                               TextColor="#1F1F24" />
                                        <Label FontSize="12" TextColor="#9A9AA6">
                                            <Label.Text>
                                                <MultiBinding StringFormat="Grade {0} · Basic salary {1:C}">
                                                    <Binding Path="Grade" />
                                                    <Binding Path="BasicSalary" />
                                                </MultiBinding>
                                            </Label.Text>
                                        </Label>
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
